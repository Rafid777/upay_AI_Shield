# upay AI Shield Environment Variables Example

# Google Gemini API Key (Obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./upay_ai_shield.db
# PostgreSQL format:
# DATABASE_URL=postgresql://username:password@localhost:5432/upay_ai_shield

# Model Configuration Paths
MODEL_PATH=ml/models/risk_model.pkl
METADATA_PATH=ml/models/model_metadata.json
FEATURE_SCHEMA_PATH=ml/models/feature_schema.json

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
